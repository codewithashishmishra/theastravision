DEBUG=True
# Run once per machine: python manage.py generate_dev_secrets --write
# Then: python manage.py reset_env_encryption
# SECRET_KEY=
# TRACKER_MASTER_KEY=
# TRACKER_ENCRYPTION_KEY=
# E2EE_INTERNAL_TOKEN=

# Local Postgres (common): postgres user
DATABASE_URL=postgres://postgres:password@localhost:5432/aastraahr_db
# Docker infra/docker compose: postgres://aastraahr:password@localhost:5432/aastraahr_db
REDIS_URL=redis://localhost:6379/0
ALLOW_S3=False
AI_SERVICE_BASE_URL=http://127.0.0.1:8001
# Astra interviewer voice — self-hosted Kokoro + Whisper (apps/voice-server)
# Local: ws://127.0.0.1:9001/ws/audio
# Salad: wss://YOUR-GROUP.salad.cloud/ws/audio (gateway port must match voice server)
XYZ_AUDIO_WS_URL=ws://127.0.0.1:9001/ws/audio
# Voice server (ngrok or Salad gateway) — interview TTS/STT
# XYZ_AUDIO_HTTP_BASE_URL=https://only-recant-salary.ngrok-free.dev
# Leave API key empty when voice server ALLOW_PUBLIC_DEMO=true and VOICE_API_KEY unset
# XYZ_AUDIO_HTTP_BASE_URL=https://persimmon-garden-xxxxx.salad.cloud
# Portal → API Access (only if gateway authentication is enabled):
# XYZ_SALAD_API_KEY=
XYZ_AUDIO_HTTP_BASE_URL=
XYZ_AUDIO_API_KEY=
XYZ_AUDIO_TIMEOUT_SECONDS=15
XYZ_AUDIO_HEARTBEAT_SECONDS=10
FRONTEND_APP_URL=http://localhost:3000
CAREERS_APP_URL=http://localhost:3001
PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# E2EE: keep True in production. Use Redis for session keys (faster than Postgres store).
REDIS_ALLOW=True
E2EE_ENABLED=True
E2EE_SESSION_TTL_SECONDS=604800
E2EE_PUBLIC_SESSION_TTL_SECONDS=900

# Local dev: True enables System Audit Dashboard request charts
METRICS_ENABLED=True

# ClickHouse (optional). When False, audit/platform log APIs use PostgreSQL only.
CLICKHOUSE_ENABLED=False
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=8123

# Dev only (DEBUG=True): bypass TLS verify for HTTPS, SMTP, and IMAP (e.g. antivirus inspection)
# PLATFORM_INSECURE_SSL=true

# Platform email (cPanel SSL/TLS for notifications@) — set password before seed_env_config
PLATFORM_SMTP_HOST=p3plzcpnl506724.prod.phx3.secureserver.net
PLATFORM_SMTP_PORT=465
PLATFORM_SMTP_USE_TLS=false
PLATFORM_SMTP_USE_SSL=true
PLATFORM_SMTP_USER=notifications@theastravision.com
PLATFORM_SMTP_PASSWORD=
PLATFORM_SMTP_FROM_EMAIL=notifications@theastravision.com
PLATFORM_SMTP_FROM_NAME=The Astra Vision
# Set false only for local dev or if antivirus TLS inspection breaks SMTP (security risk)
PLATFORM_SMTP_SSL_VERIFY=true
PLATFORM_IMAP_HOST=p3plzcpnl506724.prod.phx3.secureserver.net
PLATFORM_IMAP_PORT=993
PLATFORM_IMAP_USE_SSL=true
PLATFORM_IMAP_USER=notifications@theastravision.com
# Optional; defaults to PLATFORM_SMTP_PASSWORD when empty
# PLATFORM_IMAP_PASSWORD=
PLATFORM_IMAP_SSL_VERIFY=true
PLATFORM_DEFAULT_TENANT_FROM_EMAIL=notifications@theastravision.com
PLATFORM_SMTP_RATE_PER_MINUTE=30
PLATFORM_IMAP_FOLDER=INBOX
PLATFORM_IMAP_POLL_INTERVAL_MINUTES=5

# OpenAI (Platform Config → AI) — synced from ai-service/.env by generate_dev_secrets --write
# PLATFORM_OPENAI_API_KEY=
# PLATFORM_OPENAI_MODEL=gpt-5.4-mini
