DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-change-this
DATABASE_URL=postgres://aastraahr:password@localhost:5432/aastraahr_db
REDIS_URL=redis://localhost:6379/0
ALLOW_S3=False
AI_SERVICE_BASE_URL=http://127.0.0.1:8001
FRONTEND_APP_URL=http://localhost:3000

# E2EE: keep True in production. Use Redis for session keys (faster than Postgres store).
REDIS_ALLOW=True
E2EE_ENABLED=True

# Local dev: disable per-request metrics middleware to reduce API overhead
METRICS_ENABLED=False

# ClickHouse (optional). When False, audit/platform log APIs use PostgreSQL only.
CLICKHOUSE_ENABLED=False
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=8123
